import os
import re
import json
import datetime
import xlwings as xw

# === CONFIGURAÇÕES ===
CAMINHO_EMPRESAS = r"G:\EMPRESAS"
CAMINHO_PLANILHA = r"G:\PMA\LISTA EMPRESAS - NETO CONTABILIDADE 2025.xlsm"
ABA_PLANILHA = "MARIA CLARA"
TABELA_INICIO = 2
MODO_TESTE = False
LIMITE_EMPRESAS = 10 if MODO_TESTE else None

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
ARQUIVO_JSON_SAIDA = os.path.join(SCRIPT_DIR, "status_alvaras.json")

MAPEAMENTO_COLUNAS = {
    "ALVARÁ BOMBEIROS": 11,
    "ALVARÁ VIG SANITÁRIA": 10,
    "ALVARÁ FUNCIONAMENTO": 12,
    "LICENÇA AMBIENTAL": 13,
    "CERTIDÃO USO DO SOLO": 15
}

TIPOS_DOCUMENTOS = {
    "ALVARÁ BOMBEIROS": ["ALVARÁ BOMBEIROS"],
    "ALVARÁ VIG SANITÁRIA": [
        "ALVARÁ VIG SANITÁRIA", "ALVARÁ VIG SANITÁRIA PROVISÓRIO",
        "DISPENSA SANITÁRIA", "DISPENSA AMBIENTAL E SANITÁRIA"
    ],
    "ALVARÁ FUNCIONAMENTO": [
        "ALVARÁ FUNCIONAMENTO DEFINITIVO", "ALVARÁ FUNCIONAMENTO CONDICIONADO",
        "ALVARÁ FUNCIONAMENTO PROVISÓRIO"
    ],
    "LICENÇA AMBIENTAL": [
        "LICENÇA AMBIENTAL", "DISPENSA AMBIENTAL", "DISPENSA AMBIENTAL E SANITÁRIA"
    ],
    "CERTIDÃO USO DO SOLO": ["USO DO SOLO"]
}

SUFIXOS_IGNORAR = [" - filial", " - matriz", " - sede"]

# === FUNÇÕES AUXILIARES ===
def limpar_nome_empresa(nome):
    nome = nome.lower()
    for sufixo in SUFIXOS_IGNORAR:
        nome = nome.replace(sufixo, "")
    return nome.strip().upper()

def criar_padrao(nome_base):
    return rf"(?i)^{nome_base}\s*-\s*(val\s*)?(\d{{2}})[.-](\d{{2}})[.-](\d{{4}})"

PADROES_ARQUIVOS = {
    "ALVARÁ BOMBEIROS": criar_padrao("alvar[áa] bombeiros"),
    "USO DO SOLO": criar_padrao("uso do solo"),
    "ALVARÁ FUNCIONAMENTO DEFINITIVO": r"(?i)^alvar[áa] funcionamento\s*-\s*definitivo",
    "ALVARÁ FUNCIONAMENTO PROVISÓRIO": criar_padrao("alvar[áa] funcionamento\s*-\s*provis[óo]rio"),
    "ALVARÁ FUNCIONAMENTO CONDICIONADO": criar_padrao("alvar[áa] funcionamento\s*-\s*condicionado"),
    "ALVARÁ VIG SANITÁRIA": criar_padrao("alvar[áa] vig sanit[áa]ria"),
    "ALVARÁ VIG SANITÁRIA PROVISÓRIO": criar_padrao("alvar[áa] vig sanit[áa]ria\s*-\s*provis[óo]rio"),
    "LICENÇA AMBIENTAL": criar_padrao("licen[çc]a ambiental"),
    "DISPENSA SANITÁRIA": criar_padrao("dispensa sanit[áa]ria"),
    "DISPENSA AMBIENTAL": criar_padrao("dispensa ambiental"),
    "DISPENSA AMBIENTAL E SANITÁRIA": criar_padrao("dispensa ambiental e sanit[áa]ria")
}

def carregar_planilha():
    try:
        wb = xw.Book(CAMINHO_PLANILHA)
        ws = wb.sheets[ABA_PLANILHA]
        print("📊 Conectado à planilha")
        return wb, ws
    except Exception as e:
        print(f"❌ Erro ao conectar: {e}")
        return None, None

def extrair_empresas(ws):
    empresas = []
    try:
        ultima_linha = ws.range('A' + str(ws.cells.last_cell.row)).end('up').row
        dados = ws.range(f'A{TABELA_INICIO}:D{ultima_linha}').value
        for i, linha in enumerate(dados, start=TABELA_INICIO):
            if isinstance(linha, (list, tuple)) and len(linha) >= 4:
                nome, municipio = linha[0], linha[3]
                if nome and municipio:
                    empresas.append((str(nome).strip(), str(municipio).strip(), i))
                    if MODO_TESTE and len(empresas) >= LIMITE_EMPRESAS:
                        break
        return empresas
    except Exception as e:
        print(f"❌ Erro ao extrair empresas: {e}")
        return []

def buscar_arquivos_validos(pasta):
    return [f for f in os.listdir(pasta) if f.lower().endswith((".pdf", ".jpg", ".png", ".jpeg"))]

def extrair_data(nome_arquivo, padrao):
    match = re.search(padrao, nome_arquivo)
    if match:
        try:
            return datetime.date(int(match.group(4)), int(match.group(3)), int(match.group(2)))
        except:
            return None
    return None

def identificar_documentos(arquivos):
    documentos_identificados = {doc: [] for doc in PADROES_ARQUIVOS}
    for arq in arquivos:
        for tipo, padrao in PADROES_ARQUIVOS.items():
            if re.search(padrao, arq):
                data = extrair_data(arq, padrao)
                documentos_identificados[tipo].append((arq, data))
                break
    return documentos_identificados

def interpretar_documentos(arquivos):
    hoje = datetime.date.today()
    resultado = {tipo: None for tipo in TIPOS_DOCUMENTOS}
    documentos_identificados = identificar_documentos(arquivos)

    for categoria, tipos in TIPOS_DOCUMENTOS.items():
        definitivo = next((doc for tipo in tipos if "DEFINITIVO" in tipo for doc in documentos_identificados[tipo]), None)
        if definitivo:
            resultado[categoria] = "Definitivo"
            continue

        dispensa = next(((doc, data) for tipo in tipos if "DISPENSA" in tipo for (doc, data) in documentos_identificados[tipo] if data), None)
        if dispensa:
            resultado[categoria] = f"Dispensa. Val {dispensa[1].strftime('%d/%m/%Y')}"
            continue

        todos = [(doc, data) for tipo in tipos for (doc, data) in documentos_identificados[tipo] if data]
        if todos:
            mais_recente = max(todos, key=lambda x: x[1])
            status = "Possui" if mais_recente[1] >= hoje else "Vencido"
            resultado[categoria] = f"{status}. Val {mais_recente[1].strftime('%d/%m/%Y')}"

    return resultado

def preencher_planilha(ws, linha, resultado):
    for tipo, valor in resultado.items():
        col = MAPEAMENTO_COLUNAS.get(tipo)
        if col is None:
            continue
        celula = ws.range((linha, col))
        atual = str(celula.value).strip().upper() if celula.value else ""
        if atual in ["NÃO", "*", "SUJEITO"] and not valor:
            continue
        celula.value = valor or ("Sujeito" if tipo in ["ALVARÁ FUNCIONAMENTO", "ALVARÁ BOMBEIROS"] else atual)

# === EXECUÇÃO PRINCIPAL ===
if __name__ == "__main__":
    print("🚀 Iniciando processamento de alvarás...")
    wb, ws = carregar_planilha()
    if not wb or not ws:
        exit(1)

    empresas = extrair_empresas(ws)
    if not empresas:
        wb.close()
        exit(1)

    dados_finais = {}
    for idx, (nome, municipio, linha) in enumerate(empresas, 1):
        print(f"\n📂 [{idx}] {nome} ({municipio})")
        nome_limpo = limpar_nome_empresa(nome)
        base = os.path.join(CAMINHO_EMPRESAS, nome_limpo, "Societário", "Alvarás e Certidões")
        if not os.path.exists(base):
            print(f"    ⚠️  Pasta não encontrada: {base}")
            continue
        subpastas = [p for p in os.listdir(base) if os.path.isdir(os.path.join(base, p))]
        alvo = next((p for p in subpastas if municipio.lower() in p.lower()), None)
        caminho = os.path.join(base, alvo) if alvo else base
        if alvo:
            print(f"    📁 Subpasta usada: {alvo}")
        arquivos = buscar_arquivos_validos(caminho)
        print(f"    📄 {len(arquivos)} arquivos encontrados")
        interpretacao = interpretar_documentos(arquivos)
        dados_finais[f"{nome} ({municipio})"] = interpretacao
        preencher_planilha(ws, linha, interpretacao)
        if idx % 10 == 0:
            try:
                wb.save()
                print(f"    💾 Salvamento intermediário ({idx})")
            except Exception as e:
                print(f"    ⚠️  Erro no salvamento: {e}")
    try:
        wb.save()
        wb.close()
        print("💾 Planilha salva e Excel fechado")
    except Exception as e:
        print(f"❌ Erro ao finalizar: {e}")

    with open(ARQUIVO_JSON_SAIDA, "w", encoding="utf-8") as f:
        json.dump(dados_finais, f, ensure_ascii=False, indent=4)
    print(f"✅ Concluído! Relatório salvo em {ARQUIVO_JSON_SAIDA}")
